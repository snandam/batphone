   "width": 178.08,
   "height": 30,
   "text": "Design choices",
   "originalText": "Design choices",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "f6_p0_h",
   "autoResize": true,
