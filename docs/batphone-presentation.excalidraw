   "width": 152.64000000000001,
   "height": 30,
   "text": "Known limits",
   "originalText": "Known limits",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "f6_p1_h",
   "autoResize": true,
