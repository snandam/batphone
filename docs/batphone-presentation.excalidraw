   "id": "f4_title_sub",
   "type": "text",
   "x": 1760,
   "y": 1108,
   "width": 1480.8200000000002,
   "height": 27.5,
   "text": "Each call records where it is. A step only moves it forward from the status it expects, so repeats and races cannot corrupt it.",
