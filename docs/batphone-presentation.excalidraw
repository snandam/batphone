   "seed": 571315744,
   "version": 1,
   "versionNonce": 1078267858,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789585524628,
   "link": null,
   "locked": false,
   "id": "f6_p1_b",
   "type": "rectangle",
   "x": 2275,
   "y": 2250,
   "width": 490,
   "height": 610
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "f6",
   "roundness": null,
   "seed": 1585219972,
   "version": 1,
   "versionNonce": 2092172086,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789585524628,
   "link": null,
   "locked": false,
   "id": "f6_p1_t",
   "type": "text",
   "x": 2295,
   "y": 2270,
   "width": 459.51000000000005,
   "height": 425,
   "text": "•  Caller ID is trusted after one SMS verification;\n    a spoofed number reaches that user's contacts\n\n•  Transcripts and phone numbers are stored in\n    plaintext; transcripts travel by email\n\n•  Recordings stay at Twilio and are not deleted\n    with the call\n\n•  Transcript arrives after the call, not live;\n    time scales with recording length\n\n•  Recognition depends on Twilio's speech model;\n    English only today\n\n•  Email is at-least-once and fire-and-forget:\n    rare duplicates possible, bounces not tracked\n\n•  \"Automated answer\" is best effort: voicemail,\n    IVR menu, or an AI agent look alike",
   "originalText": "•  Caller ID is trusted after one SMS verification;\n    a spoofed number reaches that user's contacts\n\n•  Transcripts and phone numbers are stored in\n    plaintext; transcripts travel by email\n\n•  Recordings stay at Twilio and are not deleted\n    with the call\n\n•  Transcript arrives after the call, not live;\n    time scales with recording length\n\n•  Recognition depends on Twilio's speech model;\n    English only today\n\n•  Email is at-least-once and fire-and-forget:\n    rare duplicates possible, bounces not tracked\n\n•  \"Automated answer\" is best effort: voicemail,\n    IVR menu, or an AI agent look alike",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
