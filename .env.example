# ===========================================
# Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing real secrets

# ===========================================
# App Configuration
# ===========================================
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
# For a deployed build they must be passed as Docker build-args (see Dockerfile);
# setting them only at runtime has no effect on the client.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Bat Phone"

# Where Twilio and browsers reach this app, with no trailing slash. Every
# TwiML callback URL and the webhook signature check are built from it.
# Set it explicitly outside Codespaces (an ngrok or deployed HTTPS URL).
# Inside Codespaces leave it unset: it is derived as
# https://$CODESPACE_NAME-3000.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN.
# Falls back to http://localhost:3000, which Twilio cannot reach.
PUBLIC_BASE_URL=

# The Twilio number employees dial. Shown on the home page as a tel: link.
# Use E.164 (+15551234567); the app formats it for display.
NEXT_PUBLIC_BAT_PHONE_NUMBER=

# Contact address shown on the public /privacy and /terms pages. Google's
# OAuth consent screen links to those pages, so set this to a mailbox you
# read. Leave empty to show generic wording without an address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ===========================================
# Sign-in allowlist
# ===========================================
# Only Google accounts matching one of these lists may sign in; any other
# account is rejected before a user row is created. Both are comma-separated
# and case-insensitive. Set at least one; with both empty nobody can sign in.
#
# Exact addresses:
ALLOWED_EMAILS=
# Apex domains. A domain admits addresses at exactly that domain, so
# "example.com" does not admit "user@mail.example.com".
ALLOWED_EMAIL_DOMAINS=

# ===========================================
# Twilio
# ===========================================
# Account SID from the Twilio console. Every API call is scoped to it.
TWILIO_ACCOUNT_SID=
# Auth token. Read only by the webhook signature validator; never used for
# API calls.
TWILIO_AUTH_TOKEN=
# Standard API key (SID starts with SK) and its secret. Used for Verify,
# media download, resync, email, and the configure script.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The bat phone number in E.164 (+15551234567). The server-side twin of
# NEXT_PUBLIC_BAT_PHONE_NUMBER; used as caller ID for outbound calls.
TWILIO_PHONE_NUMBER=
# Verify service SID (starts with VA). Create one at
# https://console.twilio.com/us1/develop/verify/services and enable SMS.
TWILIO_VERIFY_SERVICE_SID=
# Optional. URL of your own static TwiML (for example a TwiML Bin) to play
# when the app is unreachable, such as while the codespace is stopped. When
# empty, `npm run twilio:configure` installs Twilio's free hosted Echo
# Twimlet with an "unavailable" message as the number's voice fallback URL.
TWILIO_FALLBACK_TWIML_URL=
# Optional. Text-to-speech voice for every prompt. Any voice name Twilio
# accepts on <Say>; neural voices sound far more natural than "alice".
# Defaults to Polly.Joanna-Neural when empty.
TWILIO_VOICE=
# Optional. Speech recognition model for every prompt. One of: default,
# numbers_and_commands, phone_call, experimental_conversations,
# experimental_utterances, googlev2_long, googlev2_short,
# googlev2_telephony, googlev2_telephony_short, deepgram_nova-2,
# deepgram_nova-3. Defaults to deepgram_nova-3 when empty; an unknown
# value falls back to the default with a startup warning. Compare against
# googlev2_telephony_short with the resolution report when names are
# misheard.
TWILIO_SPEECH_MODEL=
# ISO 3166-1 alpha-2 region for numbers typed without a country code.
# Defaults to CA when unset.
DEFAULT_PHONE_REGION=CA

# ===========================================
# Transcription (Deepgram)
# ===========================================
# Project API key with speech-to-text access. Reuse an existing key.
DEEPGRAM_API_KEY=

# ===========================================
# Email
# ===========================================
# Sender of the transcript emails, sent through Twilio Email with the same
# Twilio API key. The address must be verified for the Twilio account.
EMAIL_FROM=
# Display name for the sender. Defaults to "Bat Phone" when empty.
EMAIL_FROM_NAME=
# Set to true to render and log emails instead of sending them. Honoured
# outside production only; in production the value must be exactly "force".
# The server logs a warning at startup while this is on, and the call page
# marks emails that were logged instead of sent.
EMAIL_DRY_RUN=

# ===========================================
# Better Auth Configuration
# ===========================================
# Generate with: openssl rand -base64 32
# Left empty on purpose: the app refuses to boot without it, and refuses a
# short or placeholder value in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ===========================================
# Google OAuth
# ===========================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Option 1: Connection string (simpler for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/batphone

# Option 2: Separate vars (alternative to a URL; avoids encoding special
# characters in the password)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=batphone

# SSL: enabled in production by default; set false for local Postgres.
# DATABASE_SSL=false

# Max connections: default 10 in production, 4 in development
# DATABASE_MAX_CONNECTIONS=10

# Prepared statements: set to "false" for PgBouncer, RDS Proxy, or Supabase pooler
# DATABASE_PREPARE=true

# ===========================================
# Docker Configuration
# ===========================================
# These are used by docker-compose.yml for the PostgreSQL container
# Uncomment and adjust for local Docker development:

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=batphone

# When using Docker, set DATABASE_URL to point to the postgres service:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/batphone
# DATABASE_SSL=false

# ===========================================
# Development scripts
# ===========================================
# `npm run db:seed` creates one sample user with contacts and call history.
# Set this to the Google account you sign in with so the seeded history
# shows up for that account. Defaults to seed@example.com, which nobody
# can sign in as.
# SEED_EMAIL=

# `npm run db:reset` refuses to drop a database whose host is not local or
# when NODE_ENV=production. Set to 1 to override that guard on purpose.
# DB_RESET_FORCE=

# Optional CA certificate file for verified external PostgreSQL TLS.
# Supabase: Database Settings -> SSL Configuration -> Download certificate.
DATABASE_SSL_CA_FILE=

# Optional hosted deployment settings (not required by Codespaces).
# Operator credentials: never upload these as Worker application secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=
SUPABASE_DB_PASSWORD=
SUPABASE_SSL_CA_FILE=
# Worker runtime secret authenticating queue jobs; generate once and retain it.
BATPHONE_JOB_SECRET=
